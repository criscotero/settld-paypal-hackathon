# Local development values only. Real secrets live in AWS Secrets Manager (constitution X).
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres-dev
CORE_APP_PASSWORD=core-dev
ENGINE_APP_PASSWORD=engine-dev
# Host port for Postgres. Change it if 5432 is taken, and update the URLs below.
POSTGRES_PORT=5432

# Engine (apps/engine). Connects as engine_app, never as the admin user (SB-3).
DATABASE_URL=postgresql+psycopg://engine_app:engine-dev@127.0.0.1:5432/settld

# Core API (apps/api). Dev auth header (ADR-0001): only allowed when NODE_ENV is
# development or test (ADR-0003); any other value makes Core API refuse to start.
NODE_ENV=development
SETTLD_DEV_AUTH=true
# Connects as core_app, never as the admin user (SB-3).
CORE_DATABASE_URL=postgresql://core_app:core-dev@127.0.0.1:5432/settld
# Platform fee in basis points, frozen into each contract version (ADR-0004: 0 in the MVP).
PLATFORM_FEE_BPS=0
# Where apps/web lives; Core API prints invitation links to it (ADR-0005).
SETTLD_WEB_URL=http://localhost:3000

# Web (apps/web). Calls Core API only from its server (ADR-0005), always as the
# person signed in with Clerk (ADR-0006). It never sends the dev user header.
SETTLD_API_URL=http://localhost:4000/v1

# PayPal (Core API only: the only service that calls PayPal, SB-2). Sandbox app from
# developer.paypal.com → Apps & Credentials → Sandbox. Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant ID of the sandbox Business account that plays the Seller (spike: payee).
PAYPAL_SANDBOX_SELLER_MERCHANT_ID=
# Merchant ID of a second sandbox Business account that plays a Collaborator (D3 split spike).
PAYPAL_SANDBOX_COLLABORATOR_MERCHANT_ID=
# Merchant ID of the platform's own account (the Business account that owns the PayPal app).
# Core API uses it to confirm seller onboarding by tracking_id (ADR-0006).
PAYPAL_PARTNER_MERCHANT_ID=

# Core API <-> Engine bridge (ADR-0008, service-boundaries.md section 3). Ed25519 keys as
# one-line base64 DER. Generate them with: node scripts/gen-service-keys.mjs >> .env
# Core signs with CORE_SERVICE_PRIVATE_KEY and checks the Engine with ENGINE_SERVICE_PUBLIC_KEY;
# the Engine does the opposite. Without them the bridge refuses every call.
ENGINE_URL=http://localhost:8000
CORE_API_URL=http://localhost:4000
CORE_SERVICE_PRIVATE_KEY=
CORE_SERVICE_PUBLIC_KEY=
ENGINE_SERVICE_PRIVATE_KEY=
ENGINE_SERVICE_PUBLIC_KEY=

# Claude API (Engine only, SB-8): what AI checks use (ADR-0010). Without it they stay unavailable
# and answer UNCERTAIN, and everything else works. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Delivered .zip files (ADR-0020): one folder that Core API writes and the Engine reads, by hash.
# An absolute path, the same for both. SETTLD_PUBLIC_API_URL builds the download links.
SETTLD_DELIVERIES_DIR=/tmp/settld-deliveries
SETTLD_PUBLIC_API_URL=http://localhost:4000/v1
# Optional: Settld's own read-only GitHub token, only to raise the rate limit for public
# repositories (ADR-0019). Never a seller's token.
GITHUB_TOKEN=

# Mail (Core API only, SB-8; ADR-0011). Without SMTP_HOST nothing is sent and everything else works.
# Hackathon: smtp.gmail.com, your address and a Gmail app password. Production: the SES SMTP endpoint.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Clerk (ADR-0006): login for the web app; Core API verifies its session tokens.
# dashboard.clerk.com → your application → API keys. The publishable key is public;
# the secret key never reaches the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key from Clerk (API keys → JWKS public key). Verifies tokens without a network call.
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Only db:seed:test-accounts reads this, to create demo logins on a Clerk development instance. Never commit a value.
SETTLD_TEST_PASSWORD=
