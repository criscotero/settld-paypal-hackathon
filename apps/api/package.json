{
  "name": "@settld/api",
  "version": "0.0.1",
  "private": true,
  "description": "Settld Core API: the only public API; owns contracts, the milestone state machine and all PayPal writes",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json --outDir .cli-dist && node --env-file=../../.env .cli-dist/db/migrate.cli.js",
    "db:seed": "nest build && node --env-file=../../.env dist/db/seed.cli.js",
    "db:seed:demo-history": "tsc -p tsconfig.build.json --outDir .cli-dist && node --env-file=../../.env .cli-dist/db/seed-demo-history.cli.js",
    "db:seed:test-accounts": "tsc -p tsconfig.build.json --outDir .cli-dist && node --env-file=../../.env .cli-dist/db/seed-test-accounts.cli.js"
  },
  "dependencies": {
    "@clerk/backend": "3.25.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@settld/shared": "workspace:*",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "nodemailer": "^10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "supertest": "7.3.1",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.8.1"
  }
}
